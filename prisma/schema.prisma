generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String?
  status         String   @default("active")
  saleCode       String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
